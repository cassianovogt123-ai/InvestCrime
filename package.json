{
  "name": "investcrime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --experimental-strip-types src/ligacoes.test.ts",
    "desktop": "vite build && electron .",
    "build:win": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.0"
  },
  "main": "electron/main.cjs",
  "description": "Painel pessoal de casos criminais de SC",
  "author": "InvestCrime",
  "build": {
    "appId": "br.com.investcrime",
    "productName": "InvestCrime",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png",
      "artifactName": "InvestCrime-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "shortcutName": "InvestCrime",
      "artifactName": "InvestCrime-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "InvestCrime-Portatil.${ext}"
    }
  }
}
